# Configuración de ejemplo. Completar las credenciales en .env.
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL / Supabase
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE_DE_DATOS
SUPABASE_URL=https://ID_DEL_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR_CON_LA_CLAVE_PUBLICABLE
SUPABASE_SECRET_KEY=REEMPLAZAR_CON_LA_CLAVE_DEL_BACKEND

# Correo
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Servicio de códigos postales
CODIGOS_POSTALES_API_KEY=