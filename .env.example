# Configuración de ejemplo. Completar las credenciales en .env.
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL / Supabase
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE_DE_DATOS
SUPABASE_URL=https://ID_DEL_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR_CON_LA_CLAVE_PUBLICABLE
SUPABASE_SECRET_KEY=REEMPLAZAR_CON_LA_CLAVE_DEL_BACKEND

# Correo (usado para verificación y recepción de mensajes de Contacto)
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Opcional: si deseas recibir los mensajes de Contacto en otro correo distinto a EMAIL_USER
CONTACT_EMAIL=
# Opcional: API key de Brevo si usas envío HTTP en lugar de Gmail SMTP
BREVO_API_KEY=

# Servicio de códigos postales
CODIGOS_POSTALES_API_KEY=

# Opcional: clave de Google Gemini para potenciar los asistentes IA con LLM generativo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen